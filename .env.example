# Copy this file to .env (for DATABASE_URL) and .env.local (for the rest), then fill in real values.

# Postgres connection string (Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Riot Games API key (developer keys expire every 24h — regenerate at
# https://developer.riotgames.com/ and paste the new value here, then restart `npm run dev`)
RIOT_API_KEY=

# Optional: override the default Riot dev-key rate limits ("requests:seconds,requests:seconds")
# RIOT_RATE_LIMITS=20:1,100:120

# Admin panel password (protects /admin)
ADMIN_PASSWORD=changeme

# Secret used to sign the admin session cookie — set to a long random string in production
ADMIN_SESSION_SECRET=dev-only-secret-change-me

# Your own Riot ID, auto-added to the leaderboard as "🟢 Participante no oficial"
UNOFFICIAL_GAME_NAME=
UNOFFICIAL_TAG_LINE=
UNOFFICIAL_PLATFORM=euw1

# Used to build absolute URLs for SEO metadata (Open Graph, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twitch app credentials (dev.twitch.tv/console/apps) — used only to check if
# hardgam3rpro is live via the official Helix API. Leave empty to hide the badge.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
